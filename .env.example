# GEMINI_API_KEY: Required for Gemini AI API calls and smart query expansion.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# BRAVE_API_KEY: Optional API key for Brave Search API web integration.
BRAVE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SEARCH_MOCK: Set to true to use deterministic fallback mock search data (useful for offline/tests).
SEARCH_MOCK="false"

# SEARCH_CACHE_TTL_MS: TTL in milliseconds for the in-memory search cache (server.ts).
SEARCH_CACHE_TTL_MS="60000"

# SEARCH_RATE_LIMIT_MAX / SEARCH_RATE_LIMIT_WINDOW_MS: max /api/search requests per IP per window.
SEARCH_RATE_LIMIT_MAX="20"
SEARCH_RATE_LIMIT_WINDOW_MS="60000"

